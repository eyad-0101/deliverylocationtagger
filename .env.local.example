# Supabase Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Settings > API > JWT Settings > "JWT Secret" (legacy HS256
# shared secret). Used only to mint short-lived Realtime auth tokens for
# admins viewing /admin/live — never exposed to the browser.
SUPABASE_JWT_SECRET=

# Session cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=

# Credentials for the one-time /api/auth/bootstrap-admin call
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
